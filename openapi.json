              "$ref": "#/components/schemas/DailyConsumption"
            },
            "type": "array",
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "ConsumptionList"
      },
      "DailyConsumption": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "kwh": {
            "type": "number",
            "title": "Kwh"
          },
          "reading_count": {
            "type": "integer",
            "title": "Reading Count"
          }
        },
        "type": "object",
        "required": [
          "date",
          "kwh",
          "reading_count"
        ],
        "title": "DailyConsumption"
      },
      "DataIssue": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "meter_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meter Id"
          },
          "level": {
            "type": "string",
            "title": "Level"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "type",
          "meter_id",
          "level",
          "detail"
        ],
        "title": "DataIssue"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "meters_loaded": {
            "type": "integer",
            "title": "Meters Loaded"
          },
          "as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale"
          }
        },
        "type": "object",
        "required": [
          "status",
          "meters_loaded",
          "as_of",
          "stale"
        ],
        "title": "Health"
      },
      "IssueList": {
