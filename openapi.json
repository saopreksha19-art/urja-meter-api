            "description": "YYYY-MM-DD"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "description": "YYYY-MM-DD, inclusive",
              "title": "To"
            },
            "description": "YYYY-MM-DD, inclusive"
          }
        ],
        "responses": {
